@page "/gdpr"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap');

    .gm * { box-sizing: border-box; margin: 0; padding: 0; }

    .gm {
        --bg:           #080d14;
        --surface:      #0f1724;
        --surface-2:    #18222f;
        --border:       #1e2d40;
        --accent:       #3b82f6;
        --accent-glow:  rgba(59,130,246,.15);
        --covered:      #22c55e; --covered-bg: rgba(34,197,94,.08);   --covered-border: rgba(34,197,94,.25);
        --partial:      #f59e0b; --partial-bg: rgba(245,158,11,.08);  --partial-border: rgba(245,158,11,.25);
        --notcov:       #ef4444; --notcov-bg:  rgba(239,68,68,.08);   --notcov-border:  rgba(239,68,68,.25);
        --critical:     #f43f5e;
        --high:         #f97316;
        --medium:       #eab308;
        --low:          #22c55e;
        --text:         #e2e8f0;
        --text-dim:     #94a3b8;
        --text-muted:   #475569;
        --font-ui:      'DM Sans', sans-serif;
        --font-mono:    'DM Mono', monospace;
        --r:            12px;
        --r-sm:         8px;
        font-family:    var(--font-ui);
        background:     var(--bg);
        color:          var(--text);
        min-height:     100vh;
    }

    /* ── Header ─────────────────────────────────────────────────────────── */
    .gm-header {
        background: var(--surface); border-bottom: 1px solid var(--border);
        padding: 14px 24px; display: flex; align-items: center; gap: 12px;
        position: sticky; top: 0; z-index: 20;
    }
    .gm-logo {
        width: 34px; height: 34px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 10px; display: flex; align-items: center;
        justify-content: center; font-size: 17px;
        box-shadow: 0 0 20px rgba(99,102,241,.3);
    }
    .gm-title     { font-size: 17px; font-weight: 600; letter-spacing: -.02em; }
    .gm-subtitle  { font-size: 12px; color: var(--text-muted); font-family: var(--font-mono); margin-left: auto; }

    /* ── Layout ──────────────────────────────────────────────────────────── */
    .gm-content {
        max-width: 1040px; width: 100%; margin: 0 auto;
        padding: 28px 20px 60px;
        display: flex; flex-direction: column; gap: 32px;
    }

    /* ── Section headers ─────────────────────────────────────────────────── */
    .gm-section-title {
        font-size: 13px; font-weight: 600; text-transform: uppercase;
        letter-spacing: .08em; color: var(--text-muted); font-family: var(--font-mono);
        margin-bottom: 14px; display: flex; align-items: center; gap: 8px;
    }
    .gm-section-title::after {
        content: ''; flex: 1; height: 1px; background: var(--border);
    }

    /* ── Summary cards ───────────────────────────────────────────────────── */
    .gm-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
    .gm-stat {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r); padding: 16px 18px;
        display: flex; flex-direction: column; gap: 4px;
    }
    .gm-stat-value { font-size: 32px; font-weight: 700; font-family: var(--font-mono); letter-spacing: -.03em; }
    .gm-stat-label { font-size: 12px; color: var(--text-dim); }
    .gm-stat.covered  { border-color: var(--covered-border); }
    .gm-stat.partial  { border-color: var(--partial-border); }
    .gm-stat.notcov   { border-color: var(--notcov-border); }
    .val-covered { color: var(--covered); }
    .val-partial { color: var(--partial); }
    .val-notcov  { color: var(--notcov); }

    /* ── Progress bar ────────────────────────────────────────────────────── */
    .gm-progress-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); padding: 16px 18px; }
    .gm-progress-label { font-size: 12px; color: var(--text-dim); margin-bottom: 10px; }
    .gm-progress-bar { height: 8px; border-radius: 99px; background: var(--surface-2); overflow: hidden; display: flex; }
    .gm-progress-seg { height: 100%; transition: width .5s ease; }
    .gm-progress-seg.covered { background: var(--covered); }
    .gm-progress-seg.partial  { background: var(--partial); }
    .gm-progress-seg.notcov   { background: var(--notcov); }
    .gm-progress-legend { display: flex; gap: 16px; margin-top: 10px; }
    .gm-legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-dim); }
    .gm-legend-dot  { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

    /* ── Articles chips ──────────────────────────────────────────────────── */
    .gm-articles { display: flex; flex-wrap: wrap; gap: 24px; }
    .gm-article-chip {
        font-size: 11px; font-family: var(--font-mono); color: var(--accent);
        background: var(--accent-glow); border: 1px solid rgba(59,130,246,.2);
        border-radius: 20px; padding: 4px 11px;
    }

    /* ── Controls table ──────────────────────────────────────────────────── */
    .gm-controls { display: flex; flex-direction: column; gap: 8px; }
    .gm-control {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r); overflow: hidden;
    }
    .gm-control-header {
        display: grid;
        grid-template-columns: 24px 1fr auto auto;
        align-items: center; gap: 12px;
        padding: 12px 16px; cursor: pointer; user-select: none; transition: background .12s;
    }
    .gm-control-header:hover { background: var(--surface-2); }
    .gm-coverage-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .gm-coverage-dot.covered { background: var(--covered); box-shadow: 0 0 8px var(--covered); }
    .gm-coverage-dot.partial  { background: var(--partial); box-shadow: 0 0 8px var(--partial); }
    .gm-coverage-dot.notcov   { background: var(--notcov); box-shadow: 0 0 8px var(--notcov); }
    .gm-control-name { font-size: 14px; font-weight: 500; }
    .gm-coverage-badge {
        font-size: 10px; font-weight: 600; font-family: var(--font-mono);
        letter-spacing: .06em; padding: 3px 10px; border-radius: 20px; flex-shrink: 0;
    }
    .gm-coverage-badge.covered { background: var(--covered-bg); color: var(--covered); border: 1px solid var(--covered-border); }
    .gm-coverage-badge.partial  { background: var(--partial-bg); color: var(--partial); border: 1px solid var(--partial-border); }
    .gm-coverage-badge.notcov   { background: var(--notcov-bg);  color: var(--notcov);  border: 1px solid var(--notcov-border); }
    .gm-toggle { font-size: 11px; color: var(--text-muted); transition: transform .2s; flex-shrink: 0; }
    .gm-toggle.open { transform: rotate(180deg); }

    .gm-control-body {
        padding: 14px 16px 16px; border-top: 1px solid var(--border);
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }
    @@media (max-width: 640px) { .gm-control-body { grid-template-columns: 1fr; } }
    .gm-field-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); font-family: var(--font-mono); margin-bottom: 6px; }
    .gm-field-value { font-size: 13px; color: var(--text-dim); line-height: 1.6; }
    .gm-component-tag {
        display: inline-block; font-size: 11px; font-family: var(--font-mono);
        background: var(--surface-2); border: 1px solid var(--border);
        border-radius: 5px; padding: 2px 8px; color: var(--text-dim); margin: 2px;
    }
    .gm-article-tag {
        display: inline-block; font-size: 11px; font-family: var(--font-mono);
        background: var(--accent-glow); border: 1px solid rgba(59,130,246,.2);
        border-radius: 5px; padding: 2px 8px; color: var(--accent); margin: 2px;
    }
    .gm-principle-tag {
        display: inline-block; font-size: 11px; font-family: var(--font-mono);
        background: rgba(139,92,246,.08); border: 1px solid rgba(139,92,246,.2);
        border-radius: 5px; padding: 2px 8px; color: #a78bfa; margin: 2px;
    }

    /* ── PII Classification grid ─────────────────────────────────────────── */
    .gm-pii-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
    .gm-pii-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r); padding: 14px 16px;
        display: flex; flex-direction: column; gap: 10px;
        transition: border-color .15s;
    }
    .gm-pii-card:hover { border-color: var(--accent); }
    .gm-pii-header { display: flex; align-items: center; gap: 10px; }
    .gm-pii-type { font-size: 14px; font-weight: 600; font-family: var(--font-mono); }
    .gm-pii-outcome {
        font-size: 10px; font-weight: 600; font-family: var(--font-mono);
        letter-spacing: .06em; padding: 3px 10px; border-radius: 20px; margin-left: auto; flex-shrink: 0;
    }
    .gm-pii-outcome.block   { background: var(--notcov-bg);   color: var(--notcov);   border: 1px solid var(--notcov-border); }
    .gm-pii-outcome.sanitize { background: var(--partial-bg); color: var(--partial);  border: 1px solid var(--partial-border); }
    .gm-risk-badge {
        font-size: 10px; font-weight: 600; font-family: var(--font-mono);
        padding: 2px 8px; border-radius: 20px; letter-spacing: .04em;
    }
    .gm-risk-critical { background: rgba(244,63,94,.12);  color: #f43f5e; border: 1px solid rgba(244,63,94,.25); }
    .gm-risk-high     { background: rgba(249,115,22,.12); color: #f97316; border: 1px solid rgba(249,115,22,.25); }
    .gm-risk-medium   { background: rgba(234,179,8,.12);  color: #eab308; border: 1px solid rgba(234,179,8,.25); }
    .gm-risk-low      { background: rgba(34,197,94,.08);  color: #22c55e; border: 1px solid rgba(34,197,94,.2); }
    .gm-pii-category  { font-size: 11px; color: var(--text-muted); font-family: var(--font-mono); }
    .gm-pii-rationale { font-size: 12px; color: var(--text-dim); line-height: 1.6; }
    .gm-pii-tags { display: flex; flex-wrap: wrap; gap: 4px; }

    /* ── Loading / error ─────────────────────────────────────────────────── */
    .gm-loading { display: flex; align-items: center; gap: 10px; padding: 60px 20px; justify-content: center; font-size: 13px; color: var(--text-muted); font-family: var(--font-mono); }
    .gm-spinner { width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .gm-error { background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.25); border-radius: var(--r-sm); padding: 12px 16px; font-size: 13px; color: #f87171; font-family: var(--font-mono); }

    /* ── Disclaimer ──────────────────────────────────────────────────────── */
    .gm-disclaimer {
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--r);
        padding: 14px 18px; font-size: 12px; color: var(--text-muted); line-height: 1.65;
    }
    .gm-disclaimer strong { color: var(--text-dim); }
</style>

<div class="gm">

    <div class="gm-header">
        <div class="gm-logo">⚖️</div>
        <span class="gm-title">GDPR Controls Map</span>
        <span class="gm-subtitle">PRIVACY GATEWAY · POC</span>
    </div>

    @if (_loading)
    {
        <div class="gm-loading"><div class="gm-spinner"></div>Indlæser GDPR-mapping…</div>
    }
    else if (_error != null)
    {
        <div class="gm-content">
            <div class="gm-error">⚠ @_error</div>
        </div>
    }
    else if (_data != null)
    {
        <div class="gm-content">

            <!-- ── Disclaimer ─────────────────────────────────────────────── -->
            <div class="gm-disclaimer">
                <strong>OBS:</strong> Denne oversigt er udarbejdet som del af en datamatiker-hovedopgave (POC).
                Mappingen er vejledende og illustrerer, hvilke GDPR-principper systemets tekniske foranstaltninger
                adresserer — den udgør ikke juridisk rådgivning eller en formel Artikel 30-fortegnelse.
            </div>

            <!-- ── Summary ────────────────────────────────────────────────── -->
            <div>
                <div class="gm-section-title">Overordnet dækning</div>
                <div class="gm-summary">
                    <div class="gm-stat">
                        <span class="gm-stat-value">@_data.Summary.TotalControls</span>
                        <span class="gm-stat-label">Controls i alt</span>
                    </div>
                    <div class="gm-stat covered">
                        <span class="gm-stat-value val-covered">@_data.Summary.Covered</span>
                        <span class="gm-stat-label">Implementeret</span>
                    </div>
                    <div class="gm-stat partial">
                        <span class="gm-stat-value val-partial">@_data.Summary.Partial</span>
                        <span class="gm-stat-label">Delvist implementeret</span>
                    </div>
                    <div class="gm-stat notcov">
                        <span class="gm-stat-value val-notcov">@_data.Summary.NotCovered</span>
                        <span class="gm-stat-label">Ikke implementeret</span>
                    </div>
                </div>

                <div style="margin-top:12px;">
                    <div class="gm-progress-wrap">
                        <div class="gm-progress-label">Implementeringsstatus</div>
                        <div class="gm-progress-bar">
                            <div class="gm-progress-seg covered" style="width: @CoveredPct%"></div>
                            <div class="gm-progress-seg partial"  style="width: @PartialPct%"></div>
                            <div class="gm-progress-seg notcov"   style="width: @NotCovPct%"></div>
                        </div>
                        <div class="gm-progress-legend">
                            <div class="gm-legend-item"><div class="gm-legend-dot" style="background:var(--covered)"></div>Implementeret (@CoveredPct%)</div>
                            <div class="gm-legend-item"><div class="gm-legend-dot" style="background:var(--partial)"></div>Delvist (@PartialPct%)</div>
                            <div class="gm-legend-item"><div class="gm-legend-dot" style="background:var(--notcov)"></div>Ikke implementeret (@NotCovPct%)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── GDPR-artikler dækket ───────────────────────────────────── -->
            <div>
                <div class="gm-section-title">Dækkede GDPR-artikler</div>
                <div class="gm-articles">
                    @foreach (var article in _data.Summary.CoveredArticles)
                    {
                        <span class="gm-article-chip">@article</span>
                    }
                </div>
            </div>

            <!-- ── System controls ────────────────────────────────────────── -->
            <div>
                <div class="gm-section-title">Systemkontroller → GDPR</div>
                <div class="gm-controls">
                    @foreach (var ctrl in _data.SystemControls)
                    {
                        var isOpen = _openControls.Contains(ctrl.Id);
                        var cssClass = CoverageCss(ctrl.Coverage);
                        <div class="gm-control">
                            <div class="gm-control-header" @onclick="() => ToggleControl(ctrl.Id)">
                                <div class="gm-coverage-dot @cssClass"></div>
                                <span class="gm-control-name">@ctrl.Feature</span>
                                <span class="gm-coverage-badge @cssClass">@CoverageLabel(ctrl.Coverage)</span>
                                <span class="gm-toggle @(isOpen ? "open" : "")">▼</span>
                            </div>
                            @if (isOpen)
                            {
                                <div class="gm-control-body">
                                    <div>
                                        <div class="gm-field-label">Beskrivelse</div>
                                        <div class="gm-field-value">@ctrl.Description</div>
                                    </div>
                                    <div>
                                        <div class="gm-field-label">Komponenter</div>
                                        <div>
                                            @foreach (var comp in ctrl.Component.Split('·', StringSplitOptions.TrimEntries))
                                            {
                                                <span class="gm-component-tag">@comp</span>
                                            }
                                        </div>
                                    </div>
                                    <div>
                                        <div class="gm-field-label">GDPR-artikler</div>
                                        <div>
                                            @foreach (var art in ctrl.Articles)
                                            {
                                                <span class="gm-article-tag">@art</span>
                                            }
                                        </div>
                                    </div>
                                    <div>
                                        <div class="gm-field-label">Principper</div>
                                        <div>
                                            @foreach (var p in ctrl.Principles)
                                            {
                                                <span class="gm-principle-tag">@p</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ── PII-type klassifikationer ──────────────────────────────── -->
            <div>
                <div class="gm-section-title">PII-typer → GDPR-klassifikation</div>
                <div class="gm-pii-grid">
                    @foreach (var pii in _data.PiiClassifications)
                    {
                        var outcomeCss = pii.PolicyOutcome.StartsWith("BLOCK") ? "block" : "sanitize";
                        <div class="gm-pii-card">
                            <div class="gm-pii-header">
                                <span class="gm-pii-type">@pii.PiiType</span>
                                <span class="gm-risk-badge @RiskCss(pii.RiskLevel)">@pii.RiskLevel.ToString().ToUpper()</span>
                                <span class="gm-pii-outcome @outcomeCss">@pii.PolicyOutcome</span>
                            </div>
                            <div class="gm-pii-category">@pii.Category</div>
                            <div class="gm-pii-rationale">@pii.Rationale</div>
                            <div class="gm-pii-tags">
                                @foreach (var art in pii.Articles)
                                {
                                    <span class="gm-article-tag">@art</span>
                                }
                                @foreach (var pr in pii.Principles)
                                {
                                    <span class="gm-principle-tag">@pr</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    }

</div>

@code {
    private GdprMapDto?  _data;
    private bool         _loading = true;
    private string?      _error;
    private readonly HashSet<string> _openControls = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("GatewayApi");
            _data = await http.GetFromJsonAsync<GdprMapDto>("/gdpr/map");
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente GDPR-mapping fra API: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleControl(string id)
    {
        if (!_openControls.Remove(id))
            _openControls.Add(id);
    }

    // ── Procenter til progress bar ────────────────────────────────────────────
    private int CoveredPct => _data == null ? 0
        : (int)Math.Round(_data.Summary.Covered  * 100.0 / _data.Summary.TotalControls);
    private int PartialPct => _data == null ? 0
        : (int)Math.Round(_data.Summary.Partial  * 100.0 / _data.Summary.TotalControls);
    private int NotCovPct  => _data == null ? 0
        : (int)Math.Round(_data.Summary.NotCovered * 100.0 / _data.Summary.TotalControls);

    // ── CSS helpers ───────────────────────────────────────────────────────────
    private static string CoverageCss(string coverage) => coverage switch
    {
        "Covered"    => "covered",
        "Partial"    => "partial",
        "NotCovered" => "notcov",
        _            => ""
    };
    private static string CoverageLabel(string coverage) => coverage switch
    {
        "Covered"    => "IMPLEMENTERET",
        "Partial"    => "DELVIST",
        "NotCovered" => "MANGLER",
        _            => coverage
    };
    private static string RiskCss(string risk) => risk switch
    {
        "Critical" => "gm-risk-critical",
        "High"     => "gm-risk-high",
        "Medium"   => "gm-risk-medium",
        "Low"      => "gm-risk-low",
        _          => ""
    };

    // ── DTOs (spejler API-modellerne) ─────────────────────────────────────────
    private sealed record GdprMapDto(
        List<GdprSystemControlDto> SystemControls,
        List<GdprPiiClassificationDto> PiiClassifications,
        GdprCoverageSummaryDto Summary
    );
    private sealed record GdprSystemControlDto(
        string Id, string Feature, string Component,
        string[] Articles, string[] Principles,
        string Description, string Coverage
    );
    private sealed record GdprPiiClassificationDto(
        string PiiType, string Category,
        string[] Articles, string[] Principles,
        string PolicyOutcome, string RiskLevel, string Rationale
    );
    private sealed record GdprCoverageSummaryDto(
        int TotalControls, int Covered, int Partial, int NotCovered,
        string[] CoveredArticles
    );
}
