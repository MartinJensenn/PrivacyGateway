@page "/gateway"
@rendermode InteractiveServer
@using Frontend.Client
@using Microsoft.AspNetCore.Components.Forms
@inject PrivacyGatewayClient Api

<style>
    .pg * { box-sizing: border-box; margin: 0; padding: 0; }

    .pg {
        --bg:          #080d14;
        --surface:     #0f1724;
        --surface-2:   #18222f;
        --border:      #1e2d40;
        --accent:      #3b82f6;
        --allow:       #22c55e;  --allow-bg: rgba(34,197,94,.08);  --allow-border: rgba(34,197,94,.25);
        --block:       #ef4444;  --block-bg: rgba(239,68,68,.08);  --block-border: rgba(239,68,68,.25);
        --warn:        #f59e0b;  --warn-bg:  rgba(245,158,11,.08); --warn-border:  rgba(245,158,11,.25);
        --error:       #f87171;  --error-bg: rgba(248,113,113,.08);--error-border: rgba(248,113,113,.25);
        --text:        #e2e8f0;
        --text-dim:    #94a3b8;
        --text-muted:  #475569;
        --mono:        'Courier New', monospace;
        --r:           10px;
        font-family:   system-ui, sans-serif;
        background:    var(--bg);
        color:         var(--text);
        min-height:    100vh;
        display:       flex;
        flex-direction:column;
    }

    /* Header */
    .pg-header {
        background: var(--surface); border-bottom: 1px solid var(--border);
        padding: 14px 24px; display: flex; align-items: center; gap: 12px;
        position: sticky; top: 0; z-index: 20;
    }
    .pg-title { font-size: 16px; font-weight: 600; }
    .pg-subtitle { font-size: 11px; color: var(--text-muted); font-family: var(--mono); margin-left: auto; }

    /* Tabs */
    .pg-tabs {
        background: var(--bg);
        display: flex; justify-content: center;
        padding: 10px 10px 0;
        border-bottom: 1px solid var(--border);
    }
    .pg-tab-group {
        display: flex; gap: 0;
        background: var(--surface-2); border: 1px solid var(--border);
        border-radius: 8px; padding: 6px; margin-bottom: 10px;
    }
    .pg-tab {
        padding: 10px 40px; font-size: 14px; font-weight: 500; cursor: pointer;
        background: transparent; border: none; color: var(--text-muted);
        border-radius: 6px; transition: all .15s; letter-spacing: .01em;
    }
    .pg-tab:hover { color: var(--text); background: rgba(255,255,255,.04); }
    .pg-tab.active { color: var(--text); background: var(--surface); font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.4); }

    /* Content area */
    .pg-content {
        flex: 1; max-width: 860px; width: 100%; margin: 0 auto;
        padding: 24px 20px 12px; display: flex; flex-direction: column; gap: 20px;
    }

    /* Empty state */
    .pg-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding: 120px 20px 60px; text-align: center; }
    .pg-empty-title { font-size: 28px; font-weight: 600; letter-spacing: -.02em; }
    .pg-empty-desc  { font-size: 16px; color: var(--text-dim); max-width: 460px; line-height: 1.75; }
    .pg-chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 8px; }
    .pg-chip {
        font-size: 13px; font-family: var(--mono); color: var(--text-dim);
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 6px; padding: 9px 16px; cursor: pointer; transition: all .15s;
    }
    .pg-chip:hover { border-color: var(--accent); color: var(--text); }

    /* Card */
    .pg-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    .pg-card-header { display: flex; align-items: center; gap: 10px; padding: 10px 14px; cursor: pointer; user-select: none; }
    .pg-card-header:hover { background: var(--surface-2); }
    .pg-decision { font-size: 10px; font-weight: 700; font-family: var(--mono); letter-spacing: .08em; padding: 3px 10px; border-radius: 20px; flex-shrink: 0; }
    .pg-decision-allow { background: var(--allow-bg); color: var(--allow); border: 1px solid var(--allow-border); }
    .pg-decision-block { background: var(--block-bg); color: var(--block); border: 1px solid var(--block-border); }
    .pg-decision-error { background: var(--error-bg); color: var(--error); border: 1px solid var(--error-border); }
    .pg-card-reason { font-size: 12px; color: var(--text-dim); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pg-toggle { font-size: 10px; color: var(--text-muted); transition: transform .2s; }
    .pg-toggle.open { transform: rotate(180deg); }
    .pg-card-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; border-top: 1px solid var(--border); }
    .pg-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); font-family: var(--mono); margin-bottom: 6px; }
    .pg-badges { display: flex; flex-wrap: wrap; gap: 6px; }
    .pg-badge { font-size: 11px; font-family: var(--mono); padding: 3px 9px; border-radius: 6px; background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-border); }
    .pg-no-pii { font-size: 12px; color: var(--text-muted); font-family: var(--mono); }
    .pg-sanitized { background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); white-space: pre-wrap; word-break: break-word; line-height: 1.6; max-height: 200px; overflow-y: auto; }

    /* Chat messages */
    .pg-msg { display: flex; flex-direction: column; gap: 8px; animation: fadeUp .25s ease; }
    @@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; } }
    .pg-meta { font-size: 11px; color: var(--text-muted); font-family: var(--mono); padding: 0 2px; }
    .pg-meta.right { align-self: flex-end; }
    .pg-user-bubble {
        align-self: flex-end; max-width: 72%;
        background: linear-gradient(135deg, #1a3560, #0f2545);
        border: 1px solid rgba(59,130,246,.2); border-radius: var(--r) var(--r) 4px var(--r);
        padding: 10px 14px; font-size: 14px; line-height: 1.6; word-break: break-word; white-space: pre-wrap;
    }
    .pg-ai-bubble {
        align-self: flex-start; max-width: 72%;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--r) var(--r) var(--r) 4px;
        padding: 10px 14px; font-size: 14px; line-height: 1.7; word-break: break-word; white-space: pre-wrap;
    }
    .pg-ai-bubble.blocked { background: var(--block-bg); border-color: var(--block-border); color: var(--block); font-family: var(--mono); font-size: 13px; }
    .pg-analyze-note { font-size: 12px; color: var(--text-muted); font-family: var(--mono); padding-left: 4px; opacity: .7; }

    /* File upload */
    .pg-dropzone {
        position: relative; display: flex; flex-direction: column; align-items: center;
        justify-content: center; gap: 10px; padding: 36px 24px;
        background: var(--surface); border: 2px dashed var(--border);
        border-radius: var(--r); cursor: pointer; transition: all .2s; text-align: center; overflow: hidden;
    }
    .pg-dropzone:hover { border-color: var(--accent); background: var(--surface-2); }
    .pg-dropzone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .pg-dropzone-title { font-size: 15px; font-weight: 500; color: var(--text-dim); pointer-events: none; }
    .pg-dropzone-sub   { font-size: 12px; color: var(--text-muted); font-family: var(--mono); pointer-events: none; }
    .pg-file-item { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; }
    .pg-file-name { flex: 1; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pg-file-size { font-size: 11px; color: var(--text-muted); font-family: var(--mono); }
    .pg-file-remove { width: 24px; height: 24px; border-radius: 6px; background: transparent; border: 1px solid var(--border); color: var(--text-muted); cursor: pointer; font-size: 13px; display: flex; align-items: center; justify-content: center; transition: all .15s; }
    .pg-file-remove:hover { background: var(--block-bg); border-color: var(--block-border); color: var(--block); }

    /* Buttons */
    .pg-btn-primary { padding: 9px 20px; background: var(--accent); color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 500; cursor: pointer; transition: background .15s; }
    .pg-btn-primary:hover:not(:disabled) { background: #2563eb; }
    .pg-btn-primary:disabled { opacity: .4; cursor: not-allowed; }
    .pg-btn-secondary { padding: 9px 16px; background: var(--surface-2); color: var(--text-dim); border: 1px solid var(--border); border-radius: 6px; font-size: 13px; cursor: pointer; transition: all .15s; }
    .pg-btn-secondary:hover:not(:disabled) { color: var(--text); border-color: var(--text-muted); }
    .pg-btn-secondary:disabled { opacity: .4; cursor: not-allowed; }

    /* Input bar */
    .pg-bar { position: sticky; bottom: 0; background: linear-gradient(to top, var(--bg) 70%, transparent); padding: 16px 20px 20px; }
    .pg-bar-inner { max-width: 860px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
    .pg-input-wrap { display: flex; align-items: flex-end; gap: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); padding: 10px 12px; transition: border-color .2s; }
    .pg-input-wrap:focus-within { border-color: var(--accent); }
    .pg-textarea { flex: 1; background: transparent; border: none; outline: none; color: var(--text); font-family: inherit; font-size: 14px; line-height: 1.5; resize: none; min-height: 38px; max-height: 140px; }
    .pg-textarea::placeholder { color: var(--text-muted); }
    .pg-send-btn { padding: 8px 16px; border-radius: 6px; background: var(--accent); border: none; cursor: pointer; font-size: 13px; font-weight: 500; color: white; flex-shrink: 0; transition: background .15s; }
    .pg-send-btn:hover:not(:disabled) { background: #2563eb; }
    .pg-send-btn:disabled { opacity: .4; cursor: not-allowed; }
    .pg-btn-row { display: flex; gap: 8px; align-items: center; }
    .pg-btn-sm { padding: 7px 13px; border-radius: 6px; font-size: 12px; font-weight: 500; cursor: pointer; border: 1px solid var(--border); background: var(--surface-2); color: var(--text-dim); transition: all .15s; }
    .pg-btn-sm:hover:not(:disabled) { border-color: var(--accent); color: var(--text); }
    .pg-btn-sm:disabled { opacity: .4; cursor: not-allowed; }
    .pg-btn-reset { margin-left: auto; background: transparent; color: var(--text-muted); }
    .pg-btn-reset:hover:not(:disabled) { color: var(--text); }
    .pg-hint { font-size: 11px; color: var(--text-muted); font-family: var(--mono); text-align: center; }

    /* Misc */
    .pg-loading { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-muted); font-family: var(--mono); }
    .pg-spinner { width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; flex-shrink: 0; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .pg-error { background: var(--error-bg); border: 1px solid var(--error-border); border-radius: 6px; padding: 10px 14px; font-size: 13px; color: var(--error); font-family: var(--mono); }
    .pg-row { display: flex; gap: 8px; }
</style>

<div class="pg">

    <div class="pg-header">
        <span class="pg-title">Privacy Gateway</span>
        <span class="pg-subtitle">PII SCAN · SANITIZE · POLICY</span>
    </div>

    <div class="pg-tabs">
        <div class="pg-tab-group">
            <button class="@TabClass("chat")" @onclick='() => _tab = "chat"'>Chat</button>
            <button class="@TabClass("files")" @onclick='() => _tab = "files"'>Filer</button>
        </div>
    </div>

    @if (_tab == "chat")
    {
        <div class="pg-content">

            @if (_chatMessages.Count == 0 && !_chatLoading)
            {
                <div class="pg-empty">
                    <div class="pg-empty-title">Hvad vil du sende til AI'en?</div>
                    <div class="pg-empty-desc">Gateway'en scanner for PII, saniterer og håndhæver policy - Den sikre dig, at GDPR ikke er en eftertanke.</div>
                    <div class="pg-chips">
                        <div class="pg-chip" @onclick='() => _chatInput = "Kontakt mig på peter@firma.dk eller ring på 23 45 67 89"'>E-mail og telefon</div>
                        <div class="pg-chip" @onclick='() => _chatInput = "Patientens CPR er 010190-1234"'>CPR-Nummer</div>
                        <div class="pg-chip" @onclick='() => _chatInput = "Hvad er en god opskrift på rugbrød?"'>Ingen PII</div>
                    </div>
                </div>
            }

            @foreach (var msg in _chatMessages)
            {
                <div class="pg-msg">
                    <div class="pg-meta right">Du</div>
                    <div class="pg-user-bubble">@msg.Input</div>

                    @if (msg.Analysis != null)
                    {
                        <div class="pg-card">
                            <div class="pg-card-header" @onclick="() => msg.ShowDetails = !msg.ShowDetails">
                                <span class="pg-decision @GetDecisionClass(msg.Analysis.Decision)">@msg.Analysis.Decision</span>
                                <span class="pg-card-reason">@msg.Analysis.Reason</span>
                                <span class="@ToggleClass(msg.ShowDetails)">▼</span>
                            </div>
                            @if (msg.ShowDetails)
                            {
                                <div class="pg-card-body">
                                    <div>
                                        <div class="pg-label">PII Findings (@msg.Analysis.Findings.Count)</div>
                                        @if (msg.Analysis.Findings.Count == 0)
                                        {
                                            <div class="pg-no-pii">— ingen fund</div>
                                        }
                                        else
                                        {
                                            <div class="pg-badges">
                                                @foreach (var f in msg.Analysis.Findings)
                                                {
                                                    <span class="pg-badge">@f.Type · pos @f.Start</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <div class="pg-label">Saniteret tekst</div>
                                        @if (msg.Analysis.Decision == "BLOCK")
                                        {
                                            <div class="pg-no-pii"> blokeret, ingen tekst frigivet</div>
                                        }
                                        else
                                        {
                                            <pre class="pg-sanitized">@msg.Analysis.SanitizedText</pre>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @{
                        var criticalTypes = new[] { "CPR", "IBAN", "CREDIT_CARD", "PASSPORT", "DK_ACCOUNT" };
                        var criticalFound = msg.Analysis.Findings
                        .Select(f => f.Type)
                        .Where(t => criticalTypes.Contains(t))
                        .Distinct()
                        .ToList();
                    }
                    @if (criticalFound.Any() && msg.Analysis.Decision == "ALLOW")
                    {
                        <div style="background:var(--warn-bg);border:1px solid var(--warn-border);border-radius:6px;
                            padding:10px 14px;font-size:12px;color:var(--warn);font-family:var(--mono);">
                            ⚠️ Kritiske personoplysninger fundet og pseudonymiseret: <strong>@string.Join(", ", criticalFound)</strong>
                        </div>
                    }

                    @if (msg.AiResponse != null)
                    {
                        <div class="pg-meta">AI · Privacy Gateway</div>
                        <div class="@AiBubbleClass(msg.AiResponse)">@msg.AiResponse</div>
                    }
                    else if (msg.IsAnalyzeOnly)
                    {
                        <div class="pg-analyze-note">— Kun analyse, intet AI-kald</div>
                    }
                </div>
            }

            @if (_chatLoading)
            {
                <div class="pg-loading"><div class="pg-spinner"></div>Behandler via gateway…</div>
            }

            @if (!string.IsNullOrWhiteSpace(_chatError))
            {
                <div class="pg-error">@_chatError</div>
            }

        </div>

        <div class="pg-bar">
            <div class="pg-bar-inner">
                <div class="pg-input-wrap">
                    <textarea class="pg-textarea" rows="2"
                              placeholder="Skriv tekst der skal scannes og sendes til AI…"
                              @bind="_chatInput" @bind:event="oninput"
                              disabled="@(_chatLoading)"></textarea>
                    <button class="pg-send-btn" @onclick="ChatSend"
                            disabled="@(_chatLoading || string.IsNullOrWhiteSpace(_chatInput))">Send</button>
                </div>
                <div class="pg-btn-row">
                    <button class="pg-btn-sm" @onclick="ChatAnalyze"
                            disabled="@(_chatLoading || string.IsNullOrWhiteSpace(_chatInput))"> Analyser</button>
                    <button class="pg-btn-sm pg-btn-reset" @onclick="ChatReset"
                            disabled="@(_chatLoading || (_chatMessages.Count == 0 && string.IsNullOrWhiteSpace(_chatInput)))">Ryd</button>
                </div>
                <div></div><div></div>
            </div>
        </div>
    }

    @if (_tab == "files")
    {
        <div class="pg-content">

            <div class="pg-dropzone">
                <InputFile OnChange="FilesSelected" multiple accept=".pdf,.txt,.md,.csv,.log" />
                <div class="pg-dropzone-title">Vælg filer til PII-scanning</div>
                <div class="pg-dropzone-sub">PDF · TXT · MD · CSV · LOG · maks 10 MB pr. fil</div>
            </div>

            @if (_selectedFiles.Count > 0)
            {
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-muted);font-family:var(--mono);padding:0 2px;">
                        <span>@_selectedFiles.Count fil(er) klar</span>
                        <span>I alt @GetTotalSize()</span>
                    </div>
                    @for (int i = 0; i < _selectedFiles.Count; i++)
                    {
                        var file = _selectedFiles[i];
                        var idx  = i;
                        <div class="pg-file-item">
                            <span class="pg-file-name" title="@file.Name">@file.Name</span>
                            <span class="pg-file-size">@GetFileSize(file.Size)</span>
                            <button class="pg-file-remove" @onclick="() => RemoveFile(idx)" title="Fjern">✕</button>
                        </div>
                    }
                </div>

                <div class="pg-row">
                    <button class="pg-btn-primary" @onclick="AnalyzeFiles" disabled="@(_fileLoading || _selectedFiles.Count == 0)">
                        @(_fileLoading ? "Analyserer…" : $"Analyser {_selectedFiles.Count} fil(er)")
                    </button>
                    <button class="pg-btn-secondary" @onclick="FileReset" disabled="@_fileLoading">Ryd alt</button>
                </div>
            }
            else if (!_fileLoading)
            {
                <div class="pg-empty" style="padding:30px 20px;">
                    <div class="pg-empty-desc">Upload én eller flere filer. Gateway'en scanner hvert dokument for PII og viser resultater herunder.</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_fileError))
            {
                <div class="pg-error">@_fileError</div>
            }

            @if (_fileLoading)
            {
                <div class="pg-loading"><div class="pg-spinner"></div>Analyserer filer…</div>
            }

            @if (_fileResults.Count > 0)
            {
                <div style="display:flex;flex-direction:column;gap:12px;">
                    @foreach (var result in _fileResults)
                    {
                        <div>
                            <div style="font-size:12px;color:var(--text-dim);font-family:var(--mono);padding:0 2px 6px;">
                                @result.FileName · @GetFileSize(result.FileSizeBytes)
                            </div>
                            @if (result.ExtractError != null)
                            {
                                <div class="pg-error">@result.ExtractError</div>
                            }
                            else
                            {
                                <div class="pg-card">
                                    <div class="pg-card-header" @onclick="() => ToggleResult(result)">
                                        <span class="pg-decision @GetDecisionClass(result.Decision)">@result.Decision</span>
                                        <span class="pg-card-reason">@result.Reason</span>
                                        <span class="@ToggleClass(_expandedResults.Contains(result))">▼</span>
                                    </div>
                                    @if (_expandedResults.Contains(result))
                                    {
                                        <div class="pg-card-body">
                                            <div>
                                                <div class="pg-label">PII Findings (@result.Findings.Count)</div>
                                                @if (result.Findings.Count == 0)
                                                {
                                                    <div class="pg-no-pii">— ingen fund</div>
                                                }
                                                else
                                                {
                                                    <div class="pg-badges">
                                                        @foreach (var f in result.Findings)
                                                        {
                                                            <span class="pg-badge">@f.Type · pos @f.Start</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <div class="pg-label">Saniteret tekst</div>
                                                <pre class="pg-sanitized">@result.SanitizedText</pre>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    }

</div>

@code {

    private string _tab = "chat";

    // ── Chat 

    private string  _chatInput   = "";
    private bool    _chatLoading;
    private string? _chatError;

    private readonly List<ChatMessage> _chatMessages = new();

    private sealed class ChatMessage
    {
        public required string  Input         { get; init; }
        public AnalyzeResponse? Analysis      { get; set; }
        public string?          AiResponse    { get; set; }
        public bool             IsAnalyzeOnly { get; set; }
        public bool             ShowDetails   { get; set; }
    }

    private async Task ChatAnalyze()
    {
        if (string.IsNullOrWhiteSpace(_chatInput)) return;
        _chatError = null;
        _chatLoading = true;
        var text = _chatInput;
        _chatInput = "";
        try
        {
            var r = await Api.AnalyzeAsync(text);
            _chatMessages.Add(new ChatMessage { Input = text, Analysis = r, IsAnalyzeOnly = true, ShowDetails = true });
        }
        catch (Exception ex) { _chatError = ex.Message; }
        finally { _chatLoading = false; }
    }

    private async Task ChatSend()
    {
        if (string.IsNullOrWhiteSpace(_chatInput))
        {
            _chatError = "Skriv noget tekst før du sender.";
            return;
        }
        _chatError = null;
        _chatLoading = true;
        var text = _chatInput;
        _chatInput = "";
        try
        {
            var r = await Api.ChatAsync(text);
            _chatMessages.Add(new ChatMessage
            {
                Input      = text,
                Analysis   = new AnalyzeResponse(r.Decision, r.Reason, r.SanitizedText, r.Findings),
                AiResponse = r.AiResponse,
                ShowDetails = false
            });
        }
        catch (Exception ex) { _chatError = ex.Message; }
        finally { _chatLoading = false; }
    }

    private void ChatReset()
    {
        _chatMessages.Clear();
        _chatInput = "";
        _chatError = null;
    }

    // ── Files 

    private readonly List<IBrowserFile>         _selectedFiles   = new();
    private readonly List<FileAnalyzeResult>    _fileResults     = new();
    private readonly HashSet<FileAnalyzeResult> _expandedResults = new();
    private bool    _fileLoading;
    private string? _fileError;

    private void FilesSelected(InputFileChangeEventArgs e)
    {
        _fileError = null;
        foreach (var file in e.GetMultipleFiles(20))
            if (!_selectedFiles.Any(f => f.Name == file.Name))
                _selectedFiles.Add(file);
    }

    private void RemoveFile(int index)
    {
        if (index >= 0 && index < _selectedFiles.Count)
            _selectedFiles.RemoveAt(index);
    }

    private async Task AnalyzeFiles()
    {
        if (_selectedFiles.Count == 0) return;
        _fileError = null;
        _fileLoading = true;
        _fileResults.Clear();
        _expandedResults.Clear();
        try
        {
            var results = await Api.AnalyzeFilesAsync(_selectedFiles);
            _fileResults.AddRange(results);
            foreach (var r in _fileResults)
                if (r.Findings.Count > 0 || r.ExtractError != null)
                    _expandedResults.Add(r);
        }
        catch (Exception ex) { _fileError = ex.Message; }
        finally { _fileLoading = false; }
    }

    private void FileReset()
    {
        _selectedFiles.Clear();
        _fileResults.Clear();
        _expandedResults.Clear();
        _fileError = null;
    }

    private void ToggleResult(FileAnalyzeResult r)
    {
        if (!_expandedResults.Remove(r))
            _expandedResults.Add(r);
    }

    // ── Helpers

    private string TabClass(string tab) => _tab == tab ? "pg-tab active" : "pg-tab";
    private static string ToggleClass(bool open) => open ? "pg-toggle open" : "pg-toggle";
    private static string AiBubbleClass(string? r) =>
        r?.StartsWith("[SVAR BLOKERET") == true ? "pg-ai-bubble blocked" : "pg-ai-bubble";

    private static string GetDecisionClass(string d) => d switch
    {
        "ALLOW" => "pg-decision-allow",
        "BLOCK" => "pg-decision-block",
        _       => "pg-decision-error"
    };

    private static string GetFileSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / (1024.0 * 1024)).ToString("F1") + " MB";
    }

    private string GetTotalSize()
    {
        long total = 0;
        foreach (var f in _selectedFiles) total += f.Size;
        return GetFileSize(total);
    }
}
