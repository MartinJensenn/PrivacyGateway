@page "/gateway"
@rendermode InteractiveServer
@using Frontend.Client
@inject PrivacyGatewayClient Api

<h3>Privacy Gateway Demo</h3>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap: 16px;">
    <div>
        <label>Input</label><br />
        <textarea style="width:100%; height:180px;" @bind="_input"></textarea>

        <div style="margin-top:8px; display:flex; gap:8px;">
            <button @onclick="RunAnalyze" disabled="@_loading">Analyze</button>
            <button @onclick="RunChat" disabled="@_loading">Chat</button>
            <button @onclick="Reset" disabled="@_loading">Reset</button>
        </div>

        @if (_loading)
        {
            <p><em>Loading...</em></p>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p style="color:red; white-space:pre-wrap;">@_error</p>
        }
    </div>

    <div>
        <h4>Result</h4>

        @if (_analyze is not null)
        {
            <p><b>Decision:</b> @_analyze.Decision</p>
            <p><b>Reason:</b> @_analyze.Reason</p>

            <p><b>Findings:</b></p>
            @if (_analyze.Findings.Count == 0)
            {
                <p><em>No findings</em></p>
            }
            else
            {
                <ul>
                    @foreach (var f in _analyze.Findings)
                    {
                        <li>@f.Type (start @f.Start, len @f.Length)</li>
                    }
                </ul>
            }

            <p><b>Sanitized text:</b></p>
            <pre style="background:#111; color:#eee; padding:8px; white-space:pre-wrap;">@_analyze.SanitizedText</pre>
        }

        @if (_chat is not null)
        {
            <hr />
            <p><b>AI response:</b></p>
            <pre style="background:#111; color:#eee; padding:8px; white-space:pre-wrap;">@_chat.AiResponse</pre>
        }
    </div>
</div>

@code {
    private string _input = "Kontakt mig på test@mail.dk eller 12 34 56 78";
    private bool _loading;
    private string? _error;

    private AnalyzeResponse? _analyze;
    private ChatResponse? _chat;

    private async Task RunAnalyze()
    {
        _error = null;
        _chat = null;
        _loading = true;
        try
        {
            _analyze = await Api.AnalyzeAsync(_input);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunChat()
    {
        _error = null;
        _loading = true;
        try
        {
            _chat = await Api.ChatAsync(_input);

            // ChatResponse indeholder også decision/sanitized/findings,
            // men vi vil gerne vise samme panel, så vi "spejler" til analyze.
            _analyze = new AnalyzeResponse(
                _chat.Decision,
                _chat.Reason,
                _chat.SanitizedText,
                _chat.Findings
            );
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Reset()
    {
        _error = null;
        _analyze = null;
        _chat = null;
        _input = "";
    }
}