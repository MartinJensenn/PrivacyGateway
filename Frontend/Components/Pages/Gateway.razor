@page "/gateway"
@rendermode InteractiveServer
@using Frontend.Client
@inject PrivacyGatewayClient Api

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap');

    .pg * { box-sizing: border-box; margin: 0; padding: 0; }

    .pg {
        --bg:           #080d14;
        --surface:      #0f1724;
        --surface-2:    #18222f;
        --border:       #1e2d40;
        --accent:       #3b82f6;
        --accent-glow:  rgba(59,130,246,.15);
        --allow:        #22c55e;
        --allow-bg:     rgba(34,197,94,.08);
        --allow-border: rgba(34,197,94,.25);
        --block:        #ef4444;
        --block-bg:     rgba(239,68,68,.08);
        --block-border: rgba(239,68,68,.25);
        --warn:         #f59e0b;
        --warn-bg:      rgba(245,158,11,.08);
        --warn-border:  rgba(245,158,11,.25);
        --text:         #e2e8f0;
        --text-dim:     #94a3b8;
        --text-muted:   #475569;
        --font-ui:      'DM Sans', sans-serif;
        --font-mono:    'DM Mono', monospace;
        --r:            12px;
        --r-sm:         8px;

        font-family: var(--font-ui);
        background:   var(--bg);
        color:        var(--text);
        min-height:   100vh;
        display:      flex;
        flex-direction: column;
    }

    /* ── Header ── */
    .pg-header {
        background:    var(--surface);
        border-bottom: 1px solid var(--border);
        padding:       14px 24px;
        display:       flex;
        align-items:   center;
        gap:           12px;
        position:      sticky;
        top:           0;
        z-index:       20;
    }

    .pg-logo {
        width:            34px;
        height:           34px;
        background:       linear-gradient(135deg, var(--accent), #6366f1);
        border-radius:    10px;
        display:          flex;
        align-items:      center;
        justify-content:  center;
        font-size:        17px;
        flex-shrink:      0;
        box-shadow:       0 0 20px var(--accent-glow);
    }

    .pg-title {
        font-size:      17px;
        font-weight:    600;
        letter-spacing: -.02em;
    }

    .pg-pills {
        margin-left:  auto;
        display:      flex;
        gap:          6px;
    }

    .pg-pill {
        font-size:        10px;
        font-family:      var(--font-mono);
        color:            var(--text-muted);
        background:       var(--surface-2);
        border:           1px solid var(--border);
        border-radius:    20px;
        padding:          3px 9px;
        letter-spacing:   .04em;
    }

    /* ── Chat area ── */
    .pg-chat {
        flex:       1;
        max-width:  860px;
        width:      100%;
        margin:     0 auto;
        padding:    28px 20px 12px;
        display:    flex;
        flex-direction: column;
        gap:        28px;
    }

    /* ── Empty state ── */
    .pg-empty {
        flex:            1;
        display:         flex;
        flex-direction:  column;
        align-items:     center;
        justify-content: center;
        gap:             14px;
        padding:         80px 20px;
        text-align:      center;
    }

    .pg-empty-shield {
        font-size:  52px;
        opacity:    .35;
        filter:     grayscale(30%);
    }

    .pg-empty-title {
        font-size:      20px;
        font-weight:    600;
        letter-spacing: -.01em;
    }

    .pg-empty-desc {
        font-size:   13px;
        color:       var(--text-dim);
        max-width:   380px;
        line-height: 1.65;
    }

    .pg-empty-chips {
        display:   flex;
        flex-wrap: wrap;
        gap:       8px;
        justify-content: center;
        margin-top: 6px;
    }

    .pg-example-chip {
        font-size:   12px;
        font-family: var(--font-mono);
        color:       var(--text-dim);
        background:  var(--surface);
        border:      1px solid var(--border);
        border-radius: var(--r-sm);
        padding:     6px 12px;
        cursor:      pointer;
        transition:  all .15s;
        text-align: left;
    }

    .pg-example-chip:hover {
        border-color: var(--accent);
        color:        var(--text);
        background:   var(--surface-2);
    }

    /* ── Message block ── */
    .pg-msg {
        display:        flex;
        flex-direction: column;
        gap:            8px;
        animation:      fadeUp .28s ease;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* User bubble */
    .pg-user-meta {
        align-self:  flex-end;
        font-size:   11px;
        color:       var(--text-muted);
        font-family: var(--font-mono);
        padding-right: 2px;
    }

    .pg-user-bubble {
        align-self:    flex-end;
        max-width:     72%;
        background:    linear-gradient(135deg, #1a3560, #0f2545);
        border:        1px solid rgba(59,130,246,.2);
        border-radius: var(--r) var(--r) 4px var(--r);
        padding:       11px 15px;
        font-size:     14px;
        line-height:   1.6;
        word-break:    break-word;
        white-space:   pre-wrap;
    }

    /* Analysis card */
    .pg-card {
        background:    var(--surface);
        border:        1px solid var(--border);
        border-radius: var(--r);
        overflow:      hidden;
    }

    .pg-card-header {
        display:     flex;
        align-items: center;
        gap:         10px;
        padding:     10px 14px;
        cursor:      pointer;
        user-select: none;
        transition:  background .12s;
    }

    .pg-card-header:hover { background: var(--surface-2); }

    .pg-decision {
        font-size:      10px;
        font-weight:    600;
        font-family:    var(--font-mono);
        letter-spacing: .08em;
        padding:        3px 10px;
        border-radius:  20px;
        flex-shrink:    0;
    }

    .pg-decision-allow {
        background: var(--allow-bg);
        color:      var(--allow);
        border:     1px solid var(--allow-border);
    }

    .pg-decision-block {
        background: var(--block-bg);
        color:      var(--block);
        border:     1px solid var(--block-border);
    }

    .pg-card-reason {
        font-size:   12px;
        color:       var(--text-dim);
        flex:        1;
        overflow:    hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pg-toggle {
        font-size:  11px;
        color:      var(--text-muted);
        transition: transform .2s;
        flex-shrink: 0;
    }

    .pg-toggle.open { transform: rotate(180deg); }

    .pg-card-body {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        border-top: 1px solid var(--border);
    }

    .pg-label {
        font-size:      10px;
        font-weight:    600;
        text-transform: uppercase;
        letter-spacing: .08em;
        color:          var(--text-muted);
        font-family:    var(--font-mono);
        margin-bottom:  6px;
    }

    .pg-badges { display: flex; flex-wrap: wrap; gap: 6px; }

    .pg-badge {
        font-size:     11px;
        font-family:   var(--font-mono);
        padding:       3px 9px;
        border-radius: 6px;
        background:    var(--warn-bg);
        color:         var(--warn);
        border:        1px solid var(--warn-border);
    }

    .pg-no-pii {
        font-size:   12px;
        color:       var(--text-muted);
        font-family: var(--font-mono);
    }

    .pg-sanitized {
        background:  var(--surface-2);
        border:      1px solid var(--border);
        border-radius: var(--r-sm);
        padding:     10px 12px;
        font-family: var(--font-mono);
        font-size:   12px;
        color:       var(--text-dim);
        white-space: pre-wrap;
        word-break:  break-word;
        line-height: 1.6;
        max-height:  180px;
        overflow-y:  auto;
    }

    /* AI bubble */
    .pg-ai-meta {
        display:     flex;
        align-items: center;
        gap:         6px;
        font-size:   11px;
        color:       var(--text-muted);
        font-family: var(--font-mono);
        padding-left: 2px;
    }

    .pg-ai-dot {
        width:         6px;
        height:        6px;
        border-radius: 50%;
        background:    var(--accent);
        box-shadow:    0 0 8px var(--accent);
        flex-shrink:   0;
    }

    .pg-ai-bubble {
        align-self:    flex-start;
        max-width:     72%;
        background:    var(--surface);
        border:        1px solid var(--border);
        border-radius: var(--r) var(--r) var(--r) 4px;
        padding:       11px 15px;
        font-size:     14px;
        line-height:   1.7;
        word-break:    break-word;
        white-space:   pre-wrap;
    }

    .pg-blocked-bubble {
        background: var(--block-bg);
        border-color: var(--block-border);
        color: var(--block);
        font-family: var(--font-mono);
        font-size: 13px;
    }

    .pg-analyze-note {
        font-size:   12px;
        color:       var(--text-muted);
        font-family: var(--font-mono);
        padding-left: 4px;
        opacity: .7;
    }

    /* Loading */
    .pg-loading {
        display:     flex;
        align-items: center;
        gap:         10px;
        font-size:   13px;
        color:       var(--text-muted);
        font-family: var(--font-mono);
    }

    .pg-spinner {
        width:  16px;
        height: 16px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin .7s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Error */
    .pg-error {
        background:    var(--block-bg);
        border:        1px solid var(--block-border);
        border-radius: var(--r-sm);
        padding:       10px 14px;
        font-size:     13px;
        color:         var(--block);
        font-family:   var(--font-mono);
    }

    /* ── Input bar ── */
    .pg-bar {
        position:   sticky;
        bottom:     0;
        background: linear-gradient(to top, var(--bg) 70%, transparent);
        padding:    20px 20px 20px;
    }

    .pg-bar-inner {
        max-width:       860px;
        margin:          0 auto;
        display:         flex;
        flex-direction:  column;
        gap:             10px;
    }

    .pg-input-wrap {
        display:        flex;
        align-items:    flex-end;
        gap:            10px;
        background:     var(--surface);
        border:         1px solid var(--border);
        border-radius:  var(--r);
        padding:        10px 12px;
        transition:     border-color .2s, box-shadow .2s;
    }

    .pg-input-wrap:focus-within {
        border-color: var(--accent);
        box-shadow:   0 0 0 3px var(--accent-glow);
    }

    .pg-textarea {
        flex:        1;
        background:  transparent;
        border:      none;
        outline:     none;
        color:       var(--text);
        font-family: var(--font-ui);
        font-size:   14px;
        line-height: 1.5;
        resize:      none;
        min-height:  38px;
        max-height:  140px;
    }

    .pg-textarea::placeholder { color: var(--text-muted); }

    .pg-send-btn {
        width:         36px;
        height:        36px;
        border-radius: 8px;
        background:    var(--accent);
        border:        none;
        cursor:        pointer;
        display:       flex;
        align-items:   center;
        justify-content: center;
        font-size:     16px;
        flex-shrink:   0;
        transition:    all .15s;
        box-shadow:    0 0 16px var(--accent-glow);
    }

    .pg-send-btn:hover:not(:disabled) {
        background: #2563eb;
        box-shadow: 0 0 24px rgba(59,130,246,.3);
    }

    .pg-send-btn:disabled { opacity: .35; cursor: not-allowed; box-shadow: none; }

    .pg-btn-row {
        display:     flex;
        gap:         8px;
        align-items: center;
    }

    .pg-btn {
        display:      flex;
        align-items:  center;
        gap:          5px;
        padding:      7px 13px;
        border-radius: var(--r-sm);
        font-size:    12px;
        font-weight:  500;
        font-family:  var(--font-ui);
        cursor:       pointer;
        border:       none;
        transition:   all .15s;
        white-space:  nowrap;
    }

    .pg-btn:disabled { opacity: .35; cursor: not-allowed; }

    .pg-btn-analyze {
        background: var(--surface-2);
        color:      var(--text-dim);
        border:     1px solid var(--border);
    }

    .pg-btn-analyze:hover:not(:disabled) {
        border-color: var(--accent);
        color:        var(--text);
    }

    .pg-btn-reset {
        margin-left: auto;
        background:  transparent;
        color:       var(--text-muted);
        border:      1px solid var(--border);
    }

    .pg-btn-reset:hover:not(:disabled) {
        color:        var(--text);
        border-color: var(--text-muted);
    }

    .pg-hint {
        font-size:  11px;
        color:      var(--text-muted);
        font-family: var(--font-mono);
        text-align: center;
    }
</style>

<div class="pg">

    <!-- Header -->
    <div class="pg-header">
        <!-- Placeholder for logo -->
        <div class="pg-logo"></div>
        <span class="pg-title">Privacy Gateway</span>
        <div class="pg-pills">
            <span class="pg-pill">PII SCAN</span>
            <span class="pg-pill">SANITIZE</span>
            <span class="pg-pill">POLICY</span>
        </div>
    </div>

    <!-- Chat history -->
    <div class="pg-chat">

        @if (_messages.Count == 0 && !_loading)
        {
            <div class="pg-empty">
                <!-- Placeholder for empty state -->
                <div class="pg-empty-shield"></div>
                <div class="pg-empty-title">Hvad vil du sende til AI?</div>
                <div class="pg-empty-desc">
                    Gateway'en scanner for PII, saniterer og håndhæver policy — alt på backend, inden noget sendes videre.
                </div>
                <div class="pg-empty-chips">
                    <div class="pg-example-chip" @onclick='() => _input = "Kontakt mig på peter@firma.dk eller ring på 23 45 67 89"'>
                        📧 Tekst med e-mail og telefon
                    </div>
                    <div class="pg-example-chip" @onclick='() => _input = "Patientens CPR-nummer er 010190-1234 og bor på Østergade 5"'>
                        🚫 Tekst med CPR (blokeres)
                    </div>
                    <div class="pg-example-chip" @onclick='() => _input = "Hvad er en god opskrift på dansk rugbrød?"'>
                        ✅ Tekst uden PII
                    </div>
                </div>
            </div>
        }

        @foreach (var msg in _messages)
        {
            <div class="pg-msg">

                <!-- User input -->
                <div class="pg-user-meta">Du</div>
                <div class="pg-user-bubble">@msg.Input</div>

                <!-- Privacy analysis card -->
                @if (msg.Analysis is not null)
                {
                    <div class="pg-card">
                        <div class="pg-card-header" @onclick="() => msg.ShowDetails = !msg.ShowDetails">
                            <span class="pg-decision @(msg.Analysis.Decision == "BLOCK" ? "pg-decision-block" : "pg-decision-allow")">
                                @msg.Analysis.Decision
                            </span>
                            <span class="pg-card-reason">@msg.Analysis.Reason</span>
                            <span class="pg-toggle @(msg.ShowDetails ? "open" : "")">▼</span>
                        </div>

                        @if (msg.ShowDetails)
                        {
                            <div class="pg-card-body">
                                <div>
                                    <div class="pg-label">PII Findings (@msg.Analysis.Findings.Count)</div>
                                    @if (msg.Analysis.Findings.Count == 0)
                                    {
                                        <div class="pg-no-pii">— ingen fund</div>
                                    }
                                    else
                                    {
                                        <div class="pg-badges">
                                            @foreach (var f in msg.Analysis.Findings)
                                            {
                                                <span class="pg-badge">@f.Type · pos @f.Start</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div>
                                    <div class="pg-label">Saniteret tekst</div>
                                    <pre class="pg-sanitized">@msg.Analysis.SanitizedText</pre>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- AI response or status -->
                @if (msg.AiResponse is not null)
                {
                    <div class="pg-ai-meta">
                        <span class="pg-ai-dot"></span> AI · Privacy Gateway
                    </div>
                    @if (msg.AiResponse.StartsWith("[SVAR BLOKERET"))
                    {
                        <div class="pg-ai-bubble pg-blocked-bubble">@msg.AiResponse</div>
                    }
                    else
                    {
                        <div class="pg-ai-bubble">@msg.AiResponse</div>
                    }
                }
                else if (msg.IsAnalyzeOnly)
                {
                    <div class="pg-analyze-note">— Kun analyse, intet AI-kald</div>
                }

            </div>
        }

        @if (_loading)
        {
            <div class="pg-loading">
                <div class="pg-spinner"></div>
                Behandler via gateway…
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="pg-error">⚠ @_error</div>
        }

    </div>

    <!-- Input bar -->
    <div class="pg-bar">
        <div class="pg-bar-inner">
            <div class="pg-input-wrap">
                <textarea class="pg-textarea"
                          rows="2"
                          placeholder="Skriv tekst der skal scannes og sendes til AI…"
                          @bind="_input"
                          @bind:event="oninput"
                          disabled="@_loading"></textarea>
                <button class="pg-send-btn"
                        title="Send til AI"
                        @onclick="RunChat"
                        disabled="@(_loading || string.IsNullOrWhiteSpace(_input))">
                    ➤
                </button>
            </div>
            <div class="pg-btn-row">
                <button class="pg-btn pg-btn-analyze"
                        @onclick="RunAnalyze"
                        disabled="@(_loading || string.IsNullOrWhiteSpace(_input))">
                    🔍 Kun analyse
                </button>
                <button class="pg-btn pg-btn-reset"
                        @onclick="Reset"
                        disabled="@(_loading || (_messages.Count == 0 && string.IsNullOrWhiteSpace(_input)))">
                    Ryd
                </button>
            </div>
            <div class="pg-hint">Gateway scanner og saniterer automatisk inden AI-kald · API-nøgle forlader aldrig browseren</div>
        </div>
    </div>

</div>

@code {
    private string _input = "";
    private bool _loading;
    private string? _error;
    private readonly List<ChatMessage> _messages = new();

    private sealed class ChatMessage
    {
        public required string Input { get; init; }
        public AnalyzeResponse? Analysis { get; set; }
        public string? AiResponse { get; set; }
        public bool IsAnalyzeOnly { get; set; }
        public bool ShowDetails { get; set; }
    }

    private async Task RunAnalyze()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _error = null;
        _loading = true;
        var text = _input;
        _input = "";

        try
        {
            var result = await Api.AnalyzeAsync(text);
            _messages.Add(new ChatMessage
            {
                Input = text,
                Analysis = result,
                IsAnalyzeOnly = true,
                ShowDetails = true
            });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task RunChat()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _error = null;
        _loading = true;
        var text = _input;
        _input = "";

        try
        {
            var result = await Api.ChatAsync(text);
            _messages.Add(new ChatMessage
            {
                Input = text,
                Analysis = new AnalyzeResponse(result.Decision, result.Reason, result.SanitizedText, result.Findings),
                AiResponse = result.AiResponse,
                ShowDetails = false
            });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void Reset()
    {
        _messages.Clear();
        _input = "";
        _error = null;
    }
}
